{
  "name": "@zitadel/nuxt-auth",
  "version": "1.1.0",
  "type": "module",
  "description": "A comprehensive authentication integration for Nuxt 4 applications with TypeScript support and session management",
  "author": {
    "name": "Mridang Agarwalla",
    "email": "mridang@zitadel.com",
    "url": "https://github.com/zitadel"
  },
  "license": "Apache-2.0",
  "scripts": {
    "prepack": "nuxt-module-build build",
    "prepare": "npm run build",
    "build": "nuxi build",
    "lint": "eslint .",
    "lint:fix": "npx eslint . --fix",
    "clean": "rm -rf playground/.nuxt dist .nuxt",
    "typecheck": "nuxi prepare playground && tsc --noEmit",
    "dev:prepare": "nuxt-module-build build --stub",
    "docs": "typedoc",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run test/ && vitest run --config vitest.nuxt.config.ts",
    "test:e2e": "vitest run spec/",
    "test:e2e:ui": "vitest --ui spec/",
    "test:watch": "vitest test/",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "depcheck": "npx knip"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./server": {
      "types": "./dist/runtime/server/services/index.d.ts",
      "import": "./dist/runtime/server/services/index.js"
    },
    "./adapters": {
      "types": "./dist/adapter.d.mts"
    }
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ],
      "server": [
        "./dist/runtime/server/services/index.d.ts"
      ]
    }
  },
  "keywords": [
    "auth",
    "authentication",
    "authorization",
    "authn",
    "authz",
    "oauth",
    "oidc",
    "authjs",
    "jwt",
    "jwks",
    "pkce",
    "nuxt",
    "vue"
  ],
  "workspaces": [
    "playground"
  ],
  "peerDependencies": {
    "@nuxt/schema": "^4.0.0",
    "radix3": "^1.0.0",
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^20.5.0",
    "@mridang/eslint-defaults": "^1.6.1",
    "@nuxt/eslint-plugin": "^1.0.0",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/test-utils": "^3.23.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.0",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/node": "^22.18.13",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "eslint": "9.32.0",
    "happy-dom": "^20.7.0",
    "knip": "^5.66.4",
    "nitropack": "^2.11.13",
    "nuxt": "^4.0.0",
    "playwright": "^1.52.0",
    "prettier": "3.6.2",
    "semantic-release": "^25.0.3",
    "testcontainers": "^12.0.0",
    "ts-essentials": "^10.1.1",
    "typedoc": "^0.28.7",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zitadel/nuxt-auth.git"
  },
  "dependencies": {
    "@auth/core": "^0.40.0",
    "@nuxt/kit": "^4.0.0",
    "defu": "^6.1.4",
    "h3": "^1.15.5",
    "ufo": "^1.6.3"
  },
  "private": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "homepage": "https://github.com/zitadel/nuxt-auth",
  "bugs": "https://github.com/zitadel/nuxt-auth/issues",
  "publishConfig": {
    "access": "public"
  }
}
